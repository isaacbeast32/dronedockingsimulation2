<?xml version="1.0"?>
<sdf version="1.9">
  <model name="female_drone">
    <static>false</static>
    <link name="base_link">

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://female_drone/meshes/FemaleDrone.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 0.45 0 1</ambient>
          <diffuse>1 0.45 0 1</diffuse>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://female_drone/meshes/FemaleDrone.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>
